APP_NAME="Ekdromes - DDE DYT Thessalonikis"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=el
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=el_GR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=360
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Legacy application paths
LEGACY_PATH=app/legacy
ARXEIA_PATH=app/legacy/arxeia
NOMOI_PATH=app/legacy/nomoi
OUTPUT_PATH=app/legacy/output

# CAS SSO Configuration
CAS_HOSTNAME=cas
CAS_REAL_HOSTS=cas
CAS_SESSION_NAME=CASAuth
CAS_CONTROL_SESSIONS=false
CAS_PROXY=false
CAS_PORT=8443
CAS_URI=/cas
CAS_CLIENT_SERVICE=http://localhost
CAS_VALIDATION=
CAS_CERT=
CAS_VALIDATE_CN=false
CAS_LOGIN_URL=
CAS_LOGOUT_URL=
CAS_LOGOUT_REDIRECT=
CAS_REDIRECT_PATH=
CAS_ENABLE_SAML=false
CAS_VERSION=2.0
CAS_DEBUG=true
CAS_VERBOSE_ERRORS=true
CAS_MASQUERADE=

# E-Protocol Configuration
EPROTOCOL_BASE_URL=http://e-protocol/protocol
EPROTOCOL_USERNAME=
EPROTOCOL_PASSWORD=

WWWUSER=1000
WWWGROUP=1000

# ip για το php serve
SERVER_HOST=0.0.0.0

# Για χρήση κατά τις δοκιμές τοπικά ώστε να μην πρωτοκολλούνται οι εκδρομές
#EKDROMES_SKIP_PROTOCOL_SUBMISSION=true